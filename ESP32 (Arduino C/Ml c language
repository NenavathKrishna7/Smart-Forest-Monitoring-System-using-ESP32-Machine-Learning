int predictFireRisk(float temp, float hum, int smoke) {
  if (temp > 40 && smoke > 300 && hum < 30) {
    return 2; // HIGH
  } else if (temp > 32 && smoke > 150) {
    return 1; // MEDIUM
  } else {
    return 0; // LOW
  }
}

void loop() {
  float temperature = 36.2;
  float humidity = 42.5;
  int smoke = 210;

  int risk = predictFireRisk(temperature, humidity, smoke);

  if (risk == 2) {
    Serial.println("🔥 HIGH Fire Risk");
  } else if (risk == 1) {
    Serial.println("⚠ MEDIUM Fire Risk");
  } else {
    Serial.println("✅ LOW Fire Risk");
  }

  delay(5000);
}
